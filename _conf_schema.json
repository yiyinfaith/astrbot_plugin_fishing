{
  "fishing": {
    "description": "钓鱼系统配置",
    "type": "object",
    "items": {
      "cooldown_seconds": {
        "description": "钓鱼的冷却时间",
        "type": "int",
        "hint": "每次钓鱼后的冷却时间，单位为秒",
        "default": 180
      },
      "base_success_rate": {
        "description": "基础钓鱼成功率",
        "type": "float",
        "hint": "不带鱼饵时每次钓鱼钓到东西的概率，默认 0.7。区域收益按这个值设计，调高会整体提高收益",
        "default": 0.7,
        "min": 0.05,
        "max": 1.0
      },
      "auto_fishing_efficiency": {
        "description": "自动钓鱼效率",
        "type": "float",
        "hint": "自动钓鱼的出竿间隔 = 冷却时间 ÷ 效率。默认 0.5 表示自动钓鱼的频率是手动连续钓鱼的一半，每天收益约为一半；1 表示和手动一样",
        "default": 0.5,
        "min": 0.05,
        "max": 1.0
      },
      "quality_bonus_max_chance": {
        "description": "高品质鱼最大触发概率",
        "type": "float",
        "hint": "装备品质加成触发高品质鱼的最大概率（0.0-1.0），默认0.35表示35%。使用对数压缩公式处理乘法累积的品质加成，避免概率过高",
        "default": 0.35,
        "min": 0.0,
        "max": 1.0
      },
      "mythic_weights": {
        "description": "6/7/8 星神话鱼比例",
        "type": "string",
        "hint": "抽中「6 星及以上」后 6、7、8 星各自的相对权重，逗号分隔，默认 15,4,1，即 75% / 20% / 5%",
        "default": "15,4,1"
      }
    }
  },
  "steal": {
    "description": "偷鱼功能配置",
    "type": "object",
    "items": {
      "cooldown_seconds": {
        "description": "偷鱼的冷却时间",
        "type": "int",
        "hint": "每次偷鱼后的冷却时间，单位为秒",
        "default": 14400
      }
    }
  },
  "electric_fish": {
    "description": "电鱼功能配置",
    "type": "object",
    "items": {
      "enabled": {
        "description": "是否启用电鱼功能",
        "type": "bool",
        "hint": "电鱼功能的开关，关闭后用户无法使用电鱼命令",
        "default": true
      },
      "cooldown_seconds": {
        "description": "电鱼的冷却时间",
        "type": "int",
        "hint": "每次电鱼后的冷却时间，单位为秒",
        "default": 7200
      },
      "base_success_rate": {
        "description": "电鱼的基础成功率",
        "type": "float",
        "hint": "电鱼的成功率，范围0.0-1.0，默认0.6表示60%。",
        "default": 0.6,
        "min": 0.0,
        "max": 1.0
      },
      "failure_penalty_max_rate": {
        "description": "电鱼失败天罚最大百分比",
        "type": "float",
        "hint": "电鱼失败时扣除玩家金币的最大百分比（0.0-1.0）。实际扣除比例在0%到此值之间呈正态分布，默认0.5表示最高扣除50%金币",
        "default": 0.5,
        "min": 0.0,
        "max": 1.0
      },
      "failure_penalty_cap": {
        "description": "电鱼失败最多扣除的金币",
        "type": "int",
        "hint": "按百分比算出的罚款超过这个数时按这个数扣，0 表示不封顶",
        "default": 5000
      },
      "max_catch": {
        "description": "电鱼一次最多电走的鱼数",
        "type": "int",
        "hint": "成功时电走的鱼不超过这个数，默认 50",
        "default": 50
      }
    }
  },
  "game": {
    "description": "游戏全局配置",
    "type": "object",
    "items": {
      "daily_reset_hour": {
        "description": "每日刷新时间点",
        "type": "int",
        "hint": "每日刷新的时间点（小时，0-23），默认为0表示0点刷新。区域通行证当天有效，到这个时间失效",
        "default": 0
      }
    }
  },
