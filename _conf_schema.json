{
  "fishing": {
    "description": "钓鱼系统配置",
    "type": "object",
    "items": {
      "cooldown_seconds": {
        "description": "钓鱼的冷却时间",
        "type": "int",
        "hint": "每次钓鱼后的冷却时间，单位为秒",
        "default": 180
      },
      "auto_fishing_efficiency": {
        "description": "自动钓鱼效率",
        "type": "float",
        "hint": "自动钓鱼的出竿间隔 = 冷却时间 ÷ 效率。默认 0.5 表示自动钓鱼的频率是手动连续钓鱼的一半，每天收益约为一半；1 表示和手动一样",
        "default": 0.5,
        "min": 0.05,
        "max": 1.0
      },
      "quality_bonus_max_chance": {
        "description": "高品质鱼最大触发概率",
        "type": "float",
        "hint": "装备品质加成触发高品质鱼的最大概率（0.0-1.0），默认0.35表示35%。使用对数压缩公式处理乘法累积的品质加成，避免概率过高",
        "default": 0.35,
        "min": 0.0,
        "max": 1.0
      }
    }
  },
  "steal": {
    "description": "偷鱼功能配置",
    "type": "object",
    "items": {
      "cooldown_seconds": {
        "description": "偷鱼的冷却时间",
        "type": "int",
        "hint": "每次偷鱼后的冷却时间，单位为秒",
        "default": 14400
      }
    }
  },
  "electric_fish": {
    "description": "电鱼功能配置",
    "type": "object",
    "items": {
      "enabled": {
        "description": "是否启用电鱼功能",
        "type": "bool",
        "hint": "电鱼功能的开关，关闭后用户无法使用电鱼命令",
        "default": true
      },
      "cooldown_seconds": {
        "description": "电鱼的冷却时间",
        "type": "int",
        "hint": "每次电鱼后的冷却时间，单位为秒",
        "default": 7200
      },
      "base_success_rate": {
        "description": "电鱼的基础成功率",
        "type": "float",
        "hint": "电鱼的成功率，范围0.0-1.0，默认0.6表示60%。",
        "default": 0.6,
        "min": 0.0,
        "max": 1.0
      },
      "failure_penalty_max_rate": {
        "description": "电鱼失败天罚最大百分比",
        "type": "float",
        "hint": "电鱼失败时扣除玩家金币的最大百分比（0.0-1.0）。实际扣除比例在0%到此值之间呈正态分布，默认0.5表示最高扣除50%金币",
        "default": 0.5,
        "min": 0.0,
        "max": 1.0
      },
      "failure_penalty_cap": {
        "description": "电鱼失败最多扣除的金币",
        "type": "int",
        "hint": "按百分比算出的罚款超过这个数时按这个数扣，0 表示不封顶",
        "default": 5000
      }
    }
  },
  "game": {
    "description": "游戏全局配置",
    "type": "object",
    "items": {
      "daily_reset_hour": {
        "description": "每日刷新时间点",
        "type": "int",
        "hint": "每日刷新的时间点（小时，0-23），默认为0表示0点刷新。刷新时需要通行证的区域会自动续期或把玩家送回1号区域",
        "default": 0
      }
    }
  },
  "user": {
    "description": "用户系统配置",
    "type": "object",
    "items": {
      "initial_coins": {
        "description": "用户初始金币",
        "type": "int",
        "hint": "新用户注册时的初始金币数量",
        "default": 200
      },
      "transfer_fee_rate": {
        "description": "转账手续费率",
        "type": "float",
        "hint": "玩家转账时由转出方额外支付的手续费比例，0 表示不收费。例如 0.05 表示 5%",
        "default": 0.05,
        "min": 0.0,
        "max": 1.0
      }
    }
  },
  "market": {
    "description": "市场系统配置",
    "type": "object",
    "items": {
      "listing_tax_rate": {
        "description": "市场上架税率",
        "type": "float",
        "hint": "在市场上架物品时收取的税率",
        "default": 0.05
      }
    }
  },
  "sell_prices": {
    "description": "物品(鱼竿和饰品)的出售价格",
    "type": "object",
    "items": {
      "by_rarity_1": {
        "type": "int",
        "default": 100,
        "description": "稀有度1的出售价格"
      },
      "by_rarity_2": {
        "type": "int",
        "default": 500,
        "description": "稀有度2的出售价格"
      },
      "by_rarity_3": {
        "type": "int",
        "default": 2000,
        "description": "稀有度3的出售价格"
      },
      "by_rarity_4": {
        "type": "int",
        "default": 5000,
        "description": "稀有度4的出售价格"
      },
      "by_rarity_5": {
        "type": "int",
        "default": 10000,
        "description": "稀有度5的出售价格"
      }
    }
  }
}
